#!/usr/bin/env bash
#
# Deploys the tip of master to production by pushing a date-based tag (vYYYY-MM-DD).
# CircleCI's `release` workflow deploys any pushed tag matching that format.
#
# Usage: bin/deploy-production [--dry-run] [--yes]
#
# A second deploy on the same day is tagged vYYYY-MM-DD-2, vYYYY-MM-DD-3, and so on.
# To roll back, re-run the CircleCI `release` workflow for an older tag.

set -euo pipefail

dry_run=false
assume_yes=false

for arg in "$@"; do
  case "$arg" in
    --dry-run) dry_run=true ;;
    --yes|-y) assume_yes=true ;;
    -h|--help) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "Unknown option: $arg" >&2; exit 1 ;;
  esac
done

die() { echo "error: $*" >&2; exit 1; }

cd "$(git rev-parse --show-toplevel)"

[ "$(git branch --show-current)" = "master" ] || die "check out master first"
[ -z "$(git status --porcelain)" ] || die "working tree has uncommitted changes"

git fetch origin master --tags --quiet
[ "$(git rev-parse HEAD)" = "$(git rev-parse origin/master)" ] \
  || die "local master differs from origin/master; pull or push first"

date_tag="v$(date +%Y-%m-%d)"
tag="$date_tag"
suffix=1
while git rev-parse --quiet --verify "refs/tags/$tag" >/dev/null; do
  suffix=$((suffix + 1))
  tag="$date_tag-$suffix"
done

last_release="$(git describe --tags --abbrev=0 --match 'v[0-9][0-9][0-9][0-9]-*' 2>/dev/null || true)"
if [ -n "$last_release" ]; then
  range="$last_release..HEAD"
  echo "Changes since $last_release:"
else
  range="-10"
  echo "No previous release tag found; showing the last 10 commits:"
fi
git log --oneline $range
echo

if [ "$last_release" ] && [ "$(git rev-parse "$last_release^{commit}")" = "$(git rev-parse HEAD)" ]; then
  die "master is already deployed as $last_release"
fi

echo "About to deploy $(git rev-parse --short HEAD) to PRODUCTION as $tag"

if [ "$dry_run" = true ]; then
  echo "(dry run) nothing tagged or pushed"
  exit 0
fi

if [ "$assume_yes" != true ]; then
  read -r -p "Proceed? [y/N] " answer
  [ "$answer" = "y" ] || [ "$answer" = "Y" ] || die "aborted"
fi

git tag -a "$tag" -m "Production deploy $tag"
git push origin "$tag"

echo
echo "Pushed $tag. Follow the deploy in CircleCI:"
echo "https://app.circleci.com/pipelines/github/stride-nyc/remote_retro"
